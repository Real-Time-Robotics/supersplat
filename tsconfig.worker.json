{
    "compilerOptions": {
        "target": "es2022",
        "module": "es2022",
        "moduleResolution": "bundler",

        "lib": ["es2022"],
        "types": ["./worker-configuration.d.ts", "node"],

        "noEmit": true,
        "noImplicitAny": true,
        "strictNullChecks": false,
        "strictPropertyInitialization": false,
        "useUnknownInCatchVariables": false,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": [
        "worker/**/*.ts",
        "src/backend/**/*.ts",
        "worker-configuration.d.ts"
    ],
    "exclude": [
        "src/backend/**/*.test.ts",
        "dist",
        "node_modules"
    ]
}
