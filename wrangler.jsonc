{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supersplat-editor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GENESIS_BASE_URL": "https://recons.rtrobotics.com",
    "OIDC_ISSUER": "https://id.rtrobotics.com/realms/rtrobotics",
    "OIDC_CLIENT_ID": "supersplat-web"
  },
  // Free-tier Durable Objects require SQLite-backed classes.
  "durable_objects": {
    "bindings": [
      { "name": "RECON_SESSIONS", "class_name": "ReconstructionSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReconstructionSession"] }
  ],
  "routes": [{ "pattern": "editor.rtrobotics.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "supersplat-editor-staging",
      "vars": {
        "GENESIS_BASE_URL": "https://recons-staging.rtrobotics.com",
        "OIDC_ISSUER": "https://id-staging.rtrobotics.com/realms/rtrobotics",
        "OIDC_CLIENT_ID": "supersplat-web"
      },
      "durable_objects": {
        "bindings": [
          { "name": "RECON_SESSIONS", "class_name": "ReconstructionSession" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ReconstructionSession"] }
      ],
      "routes": [{ "pattern": "editor-staging.rtrobotics.com", "custom_domain": true }],
      "observability": { "enabled": true }
    }
  }
}
